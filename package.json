{
  "name": "auto-traffic-report",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate --config prisma/prisma.config.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --config prisma/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "prisma:push": "prisma db push --config prisma/prisma.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "archiver": "^7.0.1",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "puppeteer-core": "^24.43.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.19.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
