generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id              String   @id @default(uuid())
  name            String
  contactEmail    String?  @map("contact_email")
  lineUserId      String?  @map("line_user_id")
  deliveryChannel String   @map("delivery_channel") // "email" | "line" | "both"
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sites                    Site[]
  monthlyBatchSubscription MonthlyBatchSubscription?
  lineTargets              LineTarget[]

  @@map("clients")
}

model Site {
  id              String   @id @default(uuid())
  clientId        String   @map("client_id")
  siteName        String   @map("site_name")
  siteUrl         String   @map("site_url")
  ga4PropertyId   String   @map("ga4_property_id")
  reportStartDate DateTime @map("report_start_date")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reports Report[]

  @@map("sites")
}

model Report {
  id             String    @id @default(uuid())
  siteId         String    @map("site_id")
  reportMonth    DateTime  @map("report_month")
  status         String    // "generated" | "delivered" | "failed"
  reportData     String?   @map("report_data") // JSON string
  reportFilePath String?   @map("report_file_path")
  generatedAt    DateTime? @map("generated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]

  @@map("reports")
}

model MonthlyBatchSubscription {
  id              String   @id @default(uuid())
  clientId        String   @unique @map("client_id")
  deliveryChannel String   @map("delivery_channel") // "email" | "line" | "both"
  isActive          Boolean  @default(true) @map("is_active")
  excludeFromBatch  Boolean  @default(false) @map("exclude_from_batch")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("monthly_batch_subscriptions")
}

model LineTarget {
  id          String   @id @default(uuid())
  lineId      String   @unique @map("line_id") // userId or groupId
  type        String   @map("type") // "user" | "group"
  displayName String?  @map("display_name")
  clientId    String?  @map("client_id")
  isActive    Boolean  @default(true) @map("is_active")
  joinedAt    DateTime @default(now()) @map("joined_at")
  createdAt   DateTime @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("line_targets")
}

model DeliveryLog {
  id           String    @id @default(uuid())
  reportId     String    @map("report_id")
  channel      String    // "email" | "line"
  status       String    // "success" | "failed"
  errorMessage String?   @map("error_message")
  sentAt       DateTime? @map("sent_at")
  retryCount   Int       @default(0) @map("retry_count")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("delivery_logs")
}
